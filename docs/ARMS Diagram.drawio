        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\n    %% =====================================================\n    %% USER\n    %% =====================================================\n\n    U[USER]\n\n    U_ID((id PK))\n    U_NAME((name))\n    U_EMAIL((email))\n    U_PASS((password))\n    U_ROLE((role))\n\n    U --- U_ID\n    U --- U_NAME\n    U --- U_EMAIL\n    U --- U_PASS\n    U --- U_ROLE\n\n\n    %% =====================================================\n    %% RESERVATION\n    %% =====================================================\n\n    RSV[RESERVATION]\n\n    RSV_ID((id PK))\n    RSV_CODE((reservation_code))\n    RSV_DATE((reservation_date))\n    RSV_START((start_time))\n    RSV_END((end_time))\n    RSV_PURPOSE((purpose))\n    RSV_STATUS((status))\n\n    RSV --- RSV_ID\n    RSV --- RSV_CODE\n    RSV --- RSV_DATE\n    RSV --- RSV_START\n    RSV --- RSV_END\n    RSV --- RSV_PURPOSE\n    RSV --- RSV_STATUS\n\n\n    %% =====================================================\n    %% ROOM\n    %% =====================================================\n\n    R[ROOM]\n\n    R_ID((id PK))\n    R_CODE((room_code))\n    R_NAME((name))\n    R_CAP((capacity))\n    R_STATUS((status))\n    R_DESC((description))\n\n    R --- R_ID\n    R --- R_CODE\n    R --- R_NAME\n    R --- R_CAP\n    R --- R_STATUS\n    R --- R_DESC\n\n\n    %% =====================================================\n    %% ASSET\n    %% =====================================================\n\n    A[ASSET]\n\n    A_ID((id PK))\n    A_CODE((asset_code))\n    A_NAME((name))\n    A_CAT((category))\n    A_CON((condition))\n    A_LOC((location))\n    A_DESC((description))\n\n    A --- A_ID\n    A --- A_CODE\n    A --- A_NAME\n    A --- A_CAT\n    A --- A_CON\n    A --- A_LOC\n    A --- A_DESC\n\n\n    %% =====================================================\n    %% MAINTENANCE REPORT\n    %% =====================================================\n\n    M[MAINTENANCE REPORT]\n\n    M_ID((id PK))\n    M_CODE((report_code))\n    M_DESC((description))\n    M_STATUS((status))\n\n    M --- M_ID\n    M --- M_CODE\n    M --- M_DESC\n    M --- M_STATUS\n\n\n    %% =====================================================\n    %% RELATIONSHIPS\n    %% =====================================================\n\n    RU{MELAKUKAN}\n    RR{DIPESAN}\n    RM{MEMBUAT}\n    RA{DILAPORKAN}\n    RRM{DILAPORKAN}\n\n\n    %% USER - RESERVATION\n    U ---|1| RU\n    RU ---|N| RSV\n\n\n    %% ROOM - RESERVATION\n    R ---|1| RR\n    RR ---|N| RSV\n\n\n    %% USER - MAINTENANCE\n    U ---|1| RM\n    RM ---|N| M\n\n\n    %% ASSET - MAINTENANCE\n    A ---|1| RA\n    RA ---|N| M\n\n\n    %% ROOM - MAINTENANCE\n    R ---|1| RRM\n    RRM ---|N| M\n\n\n    %% =====================================================\n    %% STYLING\n    %% =====================================================\n\n    classDef entity fill:#ffffff,stroke:#000000,stroke-width:2px,color:#000000;\n    classDef attribute fill:#ffffff,stroke:#000000,stroke-width:1.5px,color:#000000;\n    classDef relation fill:#ffffff,stroke:#d00000,stroke-width:2px,color:#000000;\n\n    class U,RSV,R,A,M entity;\n    class U_ID,U_NAME,U_EMAIL,U_PASS,U_ROLE attribute;\n    class RSV_ID,RSV_CODE,RSV_DATE,RSV_START,RSV_END,RSV_PURPOSE,RSV_STATUS attribute;\n    class R_ID,R_CODE,R_NAME,R_CAP,R_STATUS,R_DESC attribute;\n    class A_ID,A_CODE,A_NAME,A_CAT,A_CON,A_LOC,A_DESC attribute;\n    class M_ID,M_CODE,M_DESC,M_STATUS attribute;\n    class RU,RR,RM,RA,RRM relation;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="iOUlawD5VWWC5Dyba_8F-119">
