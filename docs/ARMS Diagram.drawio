        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    %% =========================\n    %% PROCESS 3.0 RESERVATION\n    %% =========================\n\n    subgraph RES[\&quot;3.0 TRANSAKSI RESERVASI\&quot;]\n        U1[User]\n        A1[Admin]\n        S1[Staff]\n\n        P31((3.1&lt;br/&gt;Input Reservasi))\n        P32((3.2&lt;br/&gt;Validasi Data))\n        P33((3.3&lt;br/&gt;Cek Bentrok Jadwal))\n        P34((3.4&lt;br/&gt;Simpan Reservasi))\n        P35((3.5&lt;br/&gt;Proses Approval))\n        P36((3.6&lt;br/&gt;Auto-Reject Bentrok))\n\n        D31[(D1 Users)]\n        D32[(D3 Rooms)]\n        D33[(D4 Reservations)]\n\n        U1 --&gt;|Data Reservasi| P31\n        P31 --&gt; P32\n        P32 --&gt;|Data User| D31\n        P32 --&gt; P33\n        P33 --&gt;|Cek Jadwal| D33\n        P33 --&gt;|Cek Ruangan| D32\n\n        P33 --&gt;|Tidak Bentrok| P34\n        P33 --&gt;|Bentrok| U1\n\n        P34 --&gt; D33\n        P34 --&gt;|Status Pending| U1\n\n        A1 --&gt;|Approve / Reject| P35\n        P35 --&gt; D33\n        P35 --&gt; P36\n\n        P36 --&gt;|Cari Pending yang Bentrok| D33\n        P36 --&gt;|Ubah Status Rejected| D33\n\n        P35 --&gt;|Status Reservasi| U1\n        S1 --&gt;|Lihat Reservasi| D33\n        D33 --&gt; S1\n    end\n\n    %% =========================\n    %% PROCESS 4.0 MAINTENANCE\n    %% =========================\n\n    subgraph MAIN[\&quot;4.0 TRANSAKSI MAINTENANCE\&quot;]\n        U2[User]\n        S2[Staff]\n        A2[Admin]\n\n        P41((4.1&lt;br/&gt;Input Maintenance Report))\n        P42((4.2&lt;br/&gt;Validasi Laporan))\n        P43((4.3&lt;br/&gt;Simpan Laporan))\n        P44((4.4&lt;br/&gt;Proses Maintenance))\n        P45((4.5&lt;br/&gt;Update Kondisi Asset))\n        P46((4.6&lt;br/&gt;Selesaikan Laporan))\n\n        D41[(D1 Users)]\n        D42[(D2 Assets)]\n        D43[(D3 Rooms)]\n        D44[(D5 Maintenance Reports)]\n\n        U2 --&gt;|Laporan Kendala| P41\n        S2 --&gt;|Laporan Kendala| P41\n\n        P41 --&gt; P42\n        P42 --&gt;|Data User| D41\n        P42 --&gt; P43\n\n        P43 --&gt; D44\n        P43 --&gt;|Status Pending| U2\n        P43 --&gt; S2\n\n        S2 --&gt;|Proses Laporan| P44\n        A2 --&gt;|Kelola Maintenance| P44\n\n        P44 --&gt;|Data Asset| D42\n        P44 --&gt;|Data Room| D43\n        P44 --&gt; P45\n\n        P45 --&gt;|Update Good / Needs Repair / Damaged| D42\n        P45 --&gt; P46\n\n        P46 --&gt;|Status Completed| D44\n        D44 --&gt;|Status Maintenance| U2\n        D44 --&gt;|Status Maintenance| S2\n        D44 --&gt;|Data Maintenance| A2\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="uRKdliO4-JqM60pa-3je-1">
